<header class="item-header">
    <img class="profile-img" data-action="editImage" src="{{img}}" data-edit="img" title="{{name}}" alt="Item Image" />
    <div class="header-fields">
        {{#if locked}}
            <h1>{{name}}</h1>
        {{else}}
            <input class="itemname" name="name" type="text" value="{{name}}" placeholder="{{localize 'WOD5E.Name'}}"/>
        {{/if}}
        <div class="flexrow">
            <!-- Input the level of the rote -->
            <div class="flexcol level flex-center item-resource">
                <div>
                    <b>{{localize "WOD5E.Level"}}</b>
                </div>
                <input name="system.level" value="{{level}}" type="number" min="0" max="5"/>
            </div>
            <div class="flexcol flex-center item-resource">
                <div>
                    <b>{{localize 'WOD5E.ItemsList.Cost'}}</b>
                </div>
                <input name="system.cost" type="number" value="{{cost}}" placeholder="0"/>
            </div>
            <!-- Select the sphere this rote belongs to -->
            <div class="flexcol sphere flex-center item-resource">
                <label>
                    <b>{{localize "WOD5E.MTA.SphereType"}}</b>
                </label>
                <select name="system.sphere" data-type="String">
                    {{selectOptions sphereOptions selected=selectedSphere localize=true}}
                </select>
            </div>
            <!-- Mark this as an actual Rote (rollable, +1 die) vs a Sphere level power (descriptive only) -->
            <div class="flexcol isrote flex-center item-resource">
                <label>
                    <b>{{localize "WOD5E.MTA.IsRote"}}</b>
                </label>
                <input name="system.isRote" type="checkbox" {{checked isRote}}/>
            </div>
        </div>
    </div>
</header>
