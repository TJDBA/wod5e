<div class="paradox-check-dialog flexcol">
  <div class="paradox-base flex-group-center">
    <b>{{localize 'WOD5E.MTA.ParadoxBaseDie'}}</b>
  </div>

  <div class="paradox-options flexcol">
    {{#each options}}
      <label class="checkbox">
        <input type="checkbox" id="{{this.id}}">
        {{this.label}} (+{{this.value}})
      </label>
    {{/each}}
  </div>

  <div class="quintessence-group flex-group-center">
    <label for="inputQuintessence">{{localize 'WOD5E.MTA.QuintessenceEmpowerment'}}</label>
    <div class="flexrow">
      <i class="fas fa-minus dialog-control dialog-minus" data-action="minus" data-resource="inputQuintessence"></i>
      <input type="number" min="0" id="inputQuintessence" value="0">
      <i class="fas fa-plus dialog-control dialog-plus" data-action="plus" data-resource="inputQuintessence"></i>
    </div>
  </div>

  <div class="paradox-total flex-group-center">
    <b>{{localize 'WOD5E.MTA.TotalDice'}}: <span id="paradoxTotal">1</span></b>
  </div>
</div>
